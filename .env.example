# このファイルをコピーして .env を作り、実際の値を入れてください
# 値は Supabase ダッシュボード > Project Settings > API から取得できます
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...（anon public キー）

# npm run db:migrate（supabase/ の .sql を流す）で使う接続文字列
# Supabase ダッシュボード > Project Settings > Database > Connection string
# ※ ブラウザ用のバンドルには入りません（src/ から参照していないため）
SUPABASE_DB_URL=postgresql://postgres:（パスワード）@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres
